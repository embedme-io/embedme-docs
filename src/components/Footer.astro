---
import EditLink from "virtual:starlight/components/EditLink";
import LastUpdated from "virtual:starlight/components/LastUpdated";
import CrosspostBadges from "./CrosspostBadges.astro";
import DiscourseComments from "./DiscourseComments.astro";
import ReadMoreLinks from "./ReadMoreLinks.astro";

const isBlogPage = Astro.url.pathname.startsWith("/blog");

// Only actual blog post pages get a comments section (not the blog index, tag
// or author listings, or paginated pages). Mirrors starlight-blog's
// isAnyBlogPostPage. Injected here rather than via a MarkdownContent override so
// starlight-blog keeps ownership of MarkdownContent (importing its components
// directly trips a rolldown exports-field error on starlight-blog/libs/page).
const { id, entry } = Astro.locals.starlightRoute;
const isBlogPost = /^blog\/(?!(\d+\/?|tags\/.+|authors\/.+)$).+$/.test(id);

// Crossposts redirect off-site immediately, so never embed Discourse comments
// for them (this also avoids Discourse auto-creating a topic for the URL).
const isCrosspost = Boolean(entry.data.crosspostSource);

// Discourse embeds auto-create a forum topic keyed to the page's exact canonical
// URL the first time it's loaded. Upstream's existing threads live under
// esphome.io URLs on community.home-assistant.io -- a forum EmbedMe doesn't run
// or administer. Enabling this on docs.embedme.io would silently spam that
// forum with disconnected duplicate topics per mirrored blog post, so this stays
// permanently disabled here rather than gated on a deploy-platform env var.
const isProduction = false;

const footerLinks = [
  {
    name: "Documentation",
    children: [
      { name: "Components", url: "/components/" },
      { name: "Guides", url: "/guides/" },
      { name: "Automations", url: "/automations/" },
      { name: "Cookbook", url: "/cookbook/" },
    ],
  },
  {
    name: "Community",
    children: [
      { name: "Discord", url: "https://discord.gg/BCHEtD4A" },
      { name: "GitHub", url: "https://github.com/embedme-io/embedme" },
      { name: "Forum", url: "https://community.home-assistant.io/c/esphome/" },
    ],
  },
  {
    name: "Resources",
    children: [
      { name: "Changelog", url: "/changelog/" },
      { name: "Device List", url: "https://devices.esphome.io" },
      { name: "Development", url: "https://developers.esphome.io" },
    ],
  },
];
---

{isBlogPage && <CrosspostBadges />}
{isBlogPage && !isBlogPost && <ReadMoreLinks />}
{isBlogPost && isProduction && !isCrosspost && <DiscourseComments />}

<footer class="sl-flex">
  <div class="meta sl-flex">
    <EditLink />
    <LastUpdated />
  </div>

  <div class="site-footer not-content">
    <div class="footer-links">
      {
        footerLinks.map((section) => (
          <div class="footer-column">
            <div class="footer-heading">{section.name}</div>
            <ul>
              {section.children.map((link) => (
                <li>
                  <a
                    href={link.url}
                    {...(link.url.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                  >
                    {link.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="footer-bottom">
      <a href="https://www.openhomefoundation.org/" target="_blank" rel="noopener noreferrer" class="ohf-link">
        <span>EmbedMe builds on ESPHome, a project from the</span>
        <img
          class="ohf-dark"
          src="/images/OHF-lockup-main-color-on-dark.svg"
          alt="Open Home Foundation"
          width="200"
          height="44"
        />
        <img
          class="ohf-light"
          src="/images/OHF-lockup-main-color-on-bright.svg"
          alt="Open Home Foundation"
          width="200"
          height="44"
        />
      </a>
    </div>
  </div>
</footer>

<style>
  footer {
    flex-direction: column;
    gap: 1.5rem;
  }
  .meta {
    gap: 0.75rem 3rem;
    justify-content: space-between;
    flex-wrap: wrap;
    margin-top: 3rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .meta > :global(p:only-child) {
    margin-inline-start: auto;
  }

  .site-footer {
    border-top: 1px solid var(--sl-color-gray-5);
    margin-top: 1.5rem;
    padding-top: 2rem;
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-bottom: 2rem;
  }

  @media (max-width: 480px) {
    .footer-links {
      grid-template-columns: 1fr;
    }
  }

  .footer-heading {
    font-weight: 600;
    font-size: var(--sl-text-sm);
    margin-bottom: 0.75rem;
    color: var(--sl-color-white);
  }

  .footer-column ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-column li {
    margin-bottom: 0.4rem;
  }

  .footer-column a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
    font-size: var(--sl-text-sm);
  }

  .footer-column a:hover {
    color: var(--sl-color-white);
  }

  .footer-bottom {
    text-align: center;
    padding: 1rem 0 0;
    border-top: 1px solid var(--sl-color-gray-6);
  }

  .ohf-link {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
  }

  .ohf-link:hover {
    color: var(--sl-color-white);
  }

  :root[data-theme="dark"] .ohf-light {
    display: none;
  }
  :root[data-theme="dark"] .ohf-dark {
    display: inline;
  }
  :root:not([data-theme="dark"]) .ohf-dark {
    display: none;
  }
  :root:not([data-theme="dark"]) .ohf-light {
    display: inline;
  }
</style>
